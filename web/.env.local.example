# Supabase — get these from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://supabase.com/dashboard/project/gulewonzpqeriuhnxthu
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Used by the grader worker and arena server (server-side only, never expose)
SUPABASE_SERVICE_KEY=sb_secret_replace_me

# Anthropic AI Tutor — get an API key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Discord notifications (optional) — set on the grader worker Railway service
# Create a webhook: Discord server → Edit Channel → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Sentry error monitoring (optional but recommended for production)
# Create a project at sentry.io → Settings → Projects → DSN
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
# For source map uploads during CI/CD builds:
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=openquant-web

